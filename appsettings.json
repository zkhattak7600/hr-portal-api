{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=employeeleave.db"
  },
  "Jwt": {
    "Key": "CHANGE_ME_set_Jwt__Key_via_appsettings.Development.json_user-secrets_or_env_var",
    "Issuer": "EmployeeLeaveApi",
    "Audience": "EmployeeLeaveClient",
    "ExpiryMinutes": 60
  },
  "LeaveEntitlements": {
    "Annual": 14,
    "Sick": 8,
    "Casual": 10,
    "Unpaid": 0
  },
  "Attendance": {
    "LateAfter": "09:15:00",
    "HalfDayHours": 4
  },
  "DemoMode": false,
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ],
    "AllowVercelPreviews": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
